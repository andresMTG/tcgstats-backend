# Required: PostgreSQL connection string for local development.
DSN=postgres://postgres:postgres@localhost:5432/tcgstats?sslmode=disable

# Required: replace with a unique random secret before starting the API.
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-unique-random-secret
JWT_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=30

# HTTP API
APP_NAME=tcgstats-backend
SERVER_PORT=8080
SERVER_BASE_PATH=/api/
PPROF_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Local HTTP development. Set AUTH_COOKIE_SECURE=true behind HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# Redis refresh-token storage
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# PostgreSQL connection pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=1m
